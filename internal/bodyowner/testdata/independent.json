{
  "schema": "aegvium-bodyowner-independent-read-vectors-v1",
  "scope": "Literal finite sequential Read/Close expectations authored independently before Go implementation. No security, wire-framing, TLS, engine or runtime acceptance claim.",
  "setup": {
    "fresh_owner_per_vector": true,
    "generation": "00000000000000000000000000000000",
    "original_context": "Live deadline context kept live until Wait returns; no cancellation/retirement/Stop is injected by these sequential vectors.",
    "one_inbound_reserved": true,
    "usage_after_begin": {
      "Requests": 1,
      "Sockets": 2
    },
    "read_and_close": "For sequential vectors Read reaches its terminal return before Close; Close returns immediately with nil or a fixed synthetic error."
  },
  "script_semantics": {
    "repeat": "Repeat this exact finite read row count times. Unconsumed trailing rows are intentional and must not execute.",
    "data": "data_ascii bytes or byte_ascii repeated byte_count times. All literals are ordinary ASCII. The returned n is byte length unless reported_n is present.",
    "invalid_count": "reported_n may intentionally violate Reader rules; do not copy beyond the supplied buffer. The implementation must reject the count without slicing it.",
    "errors": {
      "None": "nil",
      "EOF": "the exact io.EOF sentinel",
      "ReadError": "fixed synthetic non-EOF error",
      "ContextCanceled": "context.Canceled returned by source without canceling the live original context",
      "WrappedEOF": "a synthetic error wrapping io.EOF; not equal to io.EOF"
    },
    "requested_buffer_sizes": "Literal run-length encoding of exact expected len(p) passed to each Read. Expanding only these finite rows is allowed; do not derive expected outcomes from product code.",
    "record_body": "Concatenate the literal expected Body segments. Empty list means zero bytes; Generation distinguishes a recorded empty body from zero Record.",
    "final_observation": "Wait returns joined Outcome with nil wait error even for read/Close failure. Inspect all flags, fixed failure enum, detached body, accounting, and subsequent inbound/owner behavior.",
    "owner_future_reserve_error": "After final usage observation call ReserveInbound once. On success immediately Close that fresh free reservation so the vector tears down its own extra reservation."
  },
  "barrier_tests_required_separately": true,
