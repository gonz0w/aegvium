#!/bin/ksh
# SPDX-License-Identifier: BSD-3-Clause
# Source only; immutable executable gates prevent actual startup/control.
daemon="/usr/local/libexec/aegvium/supervisor"
control="/usr/local/libexec/aegvium/service"
frontend="/usr/local/libexec/aegvium/frontend-owner"
# shellcheck source=/dev/null
. /etc/rc.d/rc.subr

# shellcheck disable=SC2034
rc_reload=NO
owner_running() {
	[[ "$("${control}" "$1" status 2>/dev/null)" == "AGCTL1 $1 owned-running qualified=0" ]]
}
wait_owned() {
	integer remaining=12
	while (( remaining > 0 )); do
		owner_running "$1" && return 0
		sleep 1
		(( remaining -= 1 ))
	done
	return 1
}
rc_check() {
	local mode
	mode=$("${control}" mode 2>/dev/null) || return 1
	owner_running inspector || return 1
	case "${mode}" in
	external) return 0 ;;
	bundled) owner_running frontend ;;
	*) return 1 ;;
	esac
}
rc_start() {
	local mode
	mode=$("${control}" mode 2>/dev/null) || return 1
	case "${mode}" in external|bundled) ;; *) return 1 ;; esac
	"${daemon}" >/dev/null 2>&1 &
	# Never signal $! or adopt a PID after partial/uncertain startup.
	wait_owned inspector || return 1
	if [[ "${mode}" == bundled ]]; then
		"${frontend}" >/dev/null 2>&1 &
		wait_owned frontend || return 1
	fi
}
rc_stop() {
	# Both fixed owners are asked even if one endpoint is absent or uncertain.
	"${control}" frontend stop >/dev/null 2>&1 || :
	"${control}" inspector stop >/dev/null 2>&1 || :
	# STOP only requests retirement. A later rc process has no original-child
	# custody; neither ACK, socket absence nor parsed C is reclamation proof.
	return 1
}
[[ $# == 1 ]] || exit 1
case "$1" in
stop) rc_stop ;; # bypass rc.subr prechecks after partial startup
start|check) rc_cmd "$1" ;;
restart|reload) exit 1 ;; # no fabricated qualified-restart bridge
*) exit 1 ;;
esac
